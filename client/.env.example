# Public site URL (used for canonical URLs, Open Graph and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Paystack public key (hosted checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Maps (embeds + onboarding pin)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Support / WhatsApp (international format, digits only, e.g. 2348030000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
NEXT_PUBLIC_SUPPORT_PHONE=+234 800 000 0000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@josstay.ng
