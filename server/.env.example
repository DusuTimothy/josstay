# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Aiven PostgreSQL ──────────────────────────────────────────────────────────
# Paste the Service URI from the Aiven console (include ?sslmode=require).
DATABASE_URL=postgres://avnadmin:CHANGE_ME@josstay-db-xxxx.aivencloud.com:12345/defaultdb?sslmode=require
# Path to the Aiven CA certificate. Relative paths resolve from server.
AIVEN_CA_CERT_PATH=./certs/aiven-ca.pem
# Set to false only for a local PostgreSQL container without TLS.
DB_SSL=true
DB_LOGGING=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string in production (openssl rand -hex 32).
JWT_SECRET=josstay-development-secret-change-me-please
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Platform rules ────────────────────────────────────────────────────────────
# Commission is a decimal: 0.12 = 12%. The final percentage is still open.
DEFAULT_COMMISSION_RATE=0.12
# Tax is a decimal: 0.075 = 7.5%. Keep 0 until an accountant confirms the
# treatment for collecting payments on behalf of hotels.
DEFAULT_TAX_RATE=0
# How long checkout holds a room, in minutes.
BOOKING_HOLD_MINUTES=15

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Cloudinary (hotel and room photography) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Brevo (transactional email) ───────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=bookings@josstay.ng
BREVO_SENDER_NAME=JosStay

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Google Maps (server-side geocoding / static maps) ─────────────────────────
GOOGLE_MAPS_API_KEY=
